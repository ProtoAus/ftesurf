# surfd.env -- the shared secret between the three game servers and this
# directory service.  COPY to surfd.env on the Pi, mode 0600, and put a real
# value in.  The same value goes in ftesurf/cfg/lobby_local.cfg as
# lobby_master_key, which is likewise never committed.
#
# Generate one:   openssl rand -base64 32
#
# It travels in plaintext over HTTP today, so treat it as a spam filter rather
# than a credential: it stops a stranger injecting fake lobbies, it does not
# stop anyone who can read the traffic.
SURFD_KEY=replace-me

# Steam sign-in (accounts.py).  Both are absent by default, and absent means
# off: no /board/link pages are registered at all.
#
# The board's PUBLIC address, no trailing slash.  It is the OpenID realm and
# return address and the state cookie's path, so it must be what a browser
# sees, not what surfd sees.  https, or http for a private or loopback host.
#SURFD_BOARD_URL=https://proto.bar/ftesurf/board
#
# A Steam Web API key (steamcommunity.com/dev/apikey).  Names and avatars
# only; sign-in works without it.  A secret: it rides in a request URL, so
# steam.py never puts a URL in an error or a log line.
#SURFD_STEAM_KEY=
