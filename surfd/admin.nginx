# surfd admin panel -- reverse proxy snippet
#
# INSTALLED as /etc/nginx/snippets/surfd-admin.conf by setup_public.sh and
# included by play.nginx: the panel is live at https://play.proto.bar/admin.
#
# THIS IS A SEPARATE FILE FROM surfd.nginx ON PURPOSE.
#
# The panel gets its OWN location block so that a mistake in the admin
# blueprint cannot expose /lobbies.json or /api/heartbeat, and a mistake in the
# public read-only endpoints cannot expose /admin. They share a process; they
# must not share a routing rule. If you ever find yourself merging these two
# files into one `location /` proxy_pass, that is the mistake.
#
# It needs all of:
#   1. TLS terminated on this vhost. The session cookie is the whole
#      credential and surfd sets Secure on it by default, which means the
#      panel simply will not work over plain HTTP -- that is the intended
#      behaviour, not a bug to work around with SURFD_ADMIN_INSECURE_COOKIE.
#   2. SURFD_ADMIN_HASH and SURFD_ADMIN_SECRET set in surfd.env (mkadminpw.py).
#   3. surfd restarted, and its log line "admin panel enabled at /admin"
#      present. If the log says "admin panel disabled", nothing here will work
#      and the reason is in that line.
#
# zone=surfdlogin lives in http{} scope, in conf.d/surfd-ratelimit.conf
# (setup_public.sh / install_board_endpoint.sh); limit_req_zone is not valid
# here.  It keeps a password spray off the scrypt verifier (32 MB an attempt,
# no swap); surfd's own per-IP lockout does not depend on it.

location /admin {
    proxy_pass         http://127.0.0.1:8084;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout   30s;

    # systemctl start/restart can take a few seconds; do not buffer the reply.
    proxy_buffering off;

    # X-Real-IP is set by overwrite above; admin.py believes it only from a
    # SURFD_PROXIES address (surfd.client_identity).  XFF is never read.

    # Do not let a proxy or browser keep an authenticated page.
    proxy_set_header   Cache-Control     "no-store";
    add_header         Cache-Control     "no-store" always;
    add_header         X-Robots-Tag      "noindex, nofollow" always;
}

# The login endpoint specifically, rate limited. This must come AFTER the
# generic /admin block above -- nginx picks the longest matching prefix, so the
# exact-match form wins for this one URL regardless of order, but keeping it
# below reads the way it behaves.
location = /admin/login {
    limit_req  zone=surfdlogin burst=5 nodelay;
    limit_req_status 429;

    proxy_pass         http://127.0.0.1:8084/admin/login;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout    30s;
    add_header         Cache-Control     "no-store" always;
    add_header         X-Robots-Tag      "noindex, nofollow" always;
}
