# surfd - FTESurf lobby directory - reverse proxy snippet
#
# INSTALLED, as /etc/nginx/snippets/surfd.conf, by setup_public.sh -- and this
# header used to open "NOT INSTALLED, AND DELIBERATELY SO", which stopped being
# true when play.proto.bar went up and was never corrected.  A file that
# describes an exposure it no longer has is worse than one with no header: the
# /api/board 404 was diagnosed against three documents that all still claimed
# surfd was LAN-only.
#
# THE EXPOSURE MANIFEST, which is the thing to keep true:
#
#   GET  /lobbies.json   public, read-only, not rate limited
#   GET  /health         public, read-only, not rate limited
#   GET  /api/board      public, read-only, RATE LIMITED -- see the block below
#   GET  /api/replay/N   public, read-only, RATE LIMITED HARDER -- ~1 MB a call
#   GET  /api/join       public, and the ONE route here that is not read-only:
#                        it can claim an IDLE lobby and move it.  RATE LIMITED.
#                        See the essay over its block for why it is proxied at
#                        all and what makes that safe.
#   POST /api/run        NOT proxied (write path; servers post to 127.0.0.1)
#   POST /api/heartbeat  NOT proxied, and must never be -- see below
#   everything else      404 from the vhost's own `location / { return 404; }`
#
#   (/board/, the web leaderboard, is proxied from proto.bar/ftesurf/board/ by
#   src/release/ftesurf.nginx, not from this vhost.)
#
# Before adding anything to that list, consider:
#   * /api/heartbeat is protected only by a shared secret in a form field. Over
#     plain HTTP that secret is visible to anyone on the path. Terminate TLS.
#   * surfd derives each lobby's advertised address from the socket peer. Behind
#     a proxy every heartbeat would appear to come from 127.0.0.1 and every
#     lobby would be advertised as 127.0.0.1:PORT. You MUST either
#       (a) keep /api/heartbeat off the public vhost and let game servers reach
#           port 8084 directly (recommended), or
#       (b) pass X-Forwarded-For here AND change surfd to trust it via
#           werkzeug's ProxyFix with a correct trusted-hop count. Do NOT do (b)
#           casually: a wrong hop count lets clients forge their own source IP
#           and advertise lobbies on hosts they do not own.
#     The snippet below therefore proxies only the read-only endpoints.
#
# To install:
#     sudo cp /srv/nvme/surfd/surfd.nginx /etc/nginx/snippets/surfd.conf
#     # then inside the desired server{} block:  include snippets/surfd.conf;
#     sudo nginx -t && sudo systemctl reload nginx

location = /lobbies.json {
    proxy_pass         http://127.0.0.1:8084/lobbies.json;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout    5s;

    # The menu polls this; let it be cached briefly to blunt a flood.
    proxy_cache_valid 200 2s;
    add_header X-Surfd-Proxied "1" always;
}

location = /health {
    proxy_pass      http://127.0.0.1:8084/health;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout    5s;
}

# ---------------------------------------------------------------------------
# GET /api/board -- the leaderboard the in-game scoreboard reads.  Schema 2.
#
# ADDED BECAUSE ITS ABSENCE WAS A LIVE BUG, not because the allowlist was too
# strict.  Every shipped client defaults lobby_dir to https://play.proto.bar
# (FS_LOBBY_DIR_DEFAULT), so the first player to open a scoreboard got
# "https://play.proto.bar/api/board?...: 404 Not Found".  The endpoint was
# built and verified against http://<lan-ip>:8084 directly, which is not the
# path any player takes -- so the proxy was never in the test at all.
#
# THE HEADER IS LOAD-BEARING, NOT DECORATION.  /api/board is the first
# RATE-LIMITED route to be proxied (/lobbies.json and /health are not limited
# at all), and surfd keys its limiter on the socket peer -- which behind this
# block is 127.0.0.1 for every player in the world.  Left alone that collapses
# a per-IP 120/min into one global bucket shared by the whole internet, so a
# stranger at 2 req/s would blank every scoreboard in the game: strictly worse
# than the 404 this fixes.  surfd reads X-Real-IP here, and ONLY from an
# address in SURFD_PROXIES (loopback by default) -- see the essay there.
#
# X-Forwarded-For IS SET BY OVERWRITE, deliberately unlike /lobbies.json above.
# $proxy_add_x_forwarded_for APPENDS to whatever the client sent, so its
# left-hand entries are attacker text; surfd ignores XFF entirely, and this
# keeps it from carrying a forged value to anything that might later read it.
#
# limit_req IS THE OUTER BOUND and it is where the real client address still
# exists.  The zone lives in http{} (conf.d/surfd-ratelimit.conf, installed by
# setup_public.sh) because limit_req_zone is not valid in a server or location
# block.  120r/m matches surfd's own board cap so the two agree rather than
# one silently masking the other; the burst absorbs a player opening the board
# and clicking across tabs, legs and tiers in a few seconds.
location = /api/board {
    limit_req             zone=surfdboard burst=30 nodelay;
    limit_req_status      429;

    proxy_pass         http://127.0.0.1:8084/api/board;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout    5s;

    add_header X-Surfd-Proxied "1" always;
}

# ---------------------------------------------------------------------------
# GET /api/replay/<id> -- the recording behind a board row.  Schema 3.
#
# THE HANDLE IS AN INTEGER, so this prefix carries no path component: surfd
# looks the id up in `replays` and decides for itself which file that means.
# Traversal is answered by construction rather than by filtering here, which is
# why this is a plain prefix match and not a regex trying to be clever.
#
# ITS OWN ZONE, AND A MUCH SMALLER ONE, and this is the load-bearing line in
# the block.  A board page is ~4 KB; a recording is ~1 MB and the first real
# one was 1,128,886 bytes.  At the board's 120r/m a single address could pull
# 120 MB a minute -- roughly the whole of a home upstream link, indefinitely,
# from one IP -- so reusing zone=surfdboard here would have made the leaderboard
# a bandwidth amplifier.  20r/m matches surfd's own REPLAY_RATE_MAX so the two
# agree rather than one silently masking the other, and burst=5 absorbs a
# player opening a few runs in a row without letting anyone stream the archive.
#
# surfd's limiter is the INNER bound and this is the OUTER one; both are needed
# for the reason /api/board documents at length -- behind this proxy surfd sees
# 127.0.0.1 for every player in the world unless X-Real-IP is set, and only
# limit_req still has the real address if that ever regresses.
#
# gzip ON, DELIBERATELY, against the Pi's global `gzip off`.  A .rec is plain
# text and compresses ~5x, which on a home upstream is the difference between
# a second and five.  It is safe because the negotiation is real at both ends:
# FTE emits `Accept-Encoding: gzip` only inside #ifdef AVAIL_GZDEC
# (engine/http/httpclient.c:919), and a build without it never asks, so nginx
# never compresses for a client that could not inflate it.  This is NOT a
# substitute for compressing at rest, which the retention decision still owes.
#
# proxy_buffering off SO THE FILE STREAMS.  Left on, nginx spools a 1 MB
# response into a temp file before sending a byte of it -- latency and writes
# on the NVMe that also holds the 45 GB map library, for no gain on a loopback
# upstream that is already a file read.
location ^~ /api/replay/ {
    limit_req             zone=surfdreplay burst=5 nodelay;
    limit_req_status      429;

    proxy_pass         http://127.0.0.1:8084;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout    15s;

    proxy_buffering    off;
    send_timeout       60s;

    gzip              on;
    gzip_types        text/plain;
    gzip_min_length   1000;
    gzip_proxied      any;

    add_header X-Surfd-Proxied "1" always;
}

# ---------------------------------------------------------------------------
# GET /api/join?map=<name> -- "where do I play this".  Build 67, schema 4.
#
# ADDED FOR THE SAME REASON /api/board WAS, AND THE LESSON DID NOT TAKE THE
# FIRST TIME.  The endpoint was built, tested against a throwaway surfd on
# :8085, deployed, and verified with `curl http://127.0.0.1:8084/api/join` --
# every one of which passed while the route a player actually takes returned
# `404 Not Found` from this vhost.  Every shipped client defaults lobby_dir to
# https://play.proto.bar, so "picking a map puts you on a real server" was
# false for all of them.  The manifest at the top of this file is the thing to
# keep true; a route that works on loopback is not deployed.
#
# THIS IS A WRITE-ISH ROUTE ON A READ-ONLY SNIPPET, AND THAT IS DELIBERATE.
# It takes no body and no secret, but it does have an EFFECT: it can claim an
# idle lobby and move it to another map.  It is proxied anyway because the menu
# must call it before the player has connected to anything, so there is no
# earlier moment at which they could be authenticated.  What makes that safe is
# not this block -- it is surfd's idle rule, enforced at both ends: a lobby
# with anybody on it is never a candidate, so the worst a stranger can do is
# park EMPTY servers on unpopular maps, and nobody is ever thrown out of a run.
# /api/run stays unproxied because it is a real write guarded by a secret; the
# two are not the same case and must not be merged on the strength of both
# being POST-shaped.
#
# ITS OWN ZONE AT 30r/m, MATCHING surfd's JOIN_RATE_MAX rather than guessing.
# The board's 120r/m would be wrong in the expensive direction: a board page is
# a SELECT, while a join can cost a map load -- up to ~4 s of a core and a
# 76 MB BSP read at p90 -- so the two routes are not interchangeable however
# similar their bodies look.  burst=10 absorbs a player reading down a map list
# and picking a few in a row.
#
# X-Real-IP IS LOAD-BEARING HERE IN A WAY IT IS NOT ANYWHERE ELSE.  surfd
# records the asking address in `assignments.src`, which is the only attribution
# a claim ever gets; without this header every claim in the table would read
# 127.0.0.1 and the column would be decoration.  Set by OVERWRITE, like the two
# blocks above, and surfd believes it only from SURFD_PROXIES (loopback).
location = /api/join {
    limit_req             zone=surfdjoin burst=10 nodelay;
    limit_req_status      429;

    proxy_pass         http://127.0.0.1:8084/api/join$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $remote_addr;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout    5s;

    add_header X-Surfd-Proxied "1" always;
}

# NOTE ON CACHING, because the /lobbies.json block above is misleading:
# `proxy_cache_valid` is INERT without a `proxy_cache <zone>` directive and an
# http{}-level `proxy_cache_path ... keys_zone=<zone>`.  Neither exists
# anywhere in this tree, so the "cached briefly to blunt a flood" comment on
# /lobbies.json describes behaviour that has never happened.  No cache is
# declared for /api/board either -- and if one ever is, note that the cache key
# MUST include $is_args$args, or every leg, tier and style of a map would be
# served the first one's board.
#
# /api/run IS NOT PROXIED.  It is a WRITE endpoint guarded only by a shared
# secret in a form field, and nothing needs it here: all five game servers run
# on this box and post to 127.0.0.1:8084 directly.  It becomes necessary only
# when a keyed server runs somewhere else, and that is a deliberate decision to
# take then -- with TLS already terminated here, which is the one part that is
# already true.

# Heartbeats are intentionally NOT proxied. Uncommenting this without doing
# the ProxyFix work described above will break every advertised address.
#
# location = /api/heartbeat {
#     return 404;
# }
