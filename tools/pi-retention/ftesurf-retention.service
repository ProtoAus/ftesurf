[Unit]
Description=World of Surf backup rotation: keep the newest 2 (P1702; tools/pi-retention.md)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3.11 -I -B /srv/nvme/ftesurf-ops/retention/pi_retention.py --apply --log /srv/nvme/ftesurf-ops/retention/retention.log
