# R2 handoff for the existing public paths. Render @PORT@ before installation.
# No bulk proxying: current verified files get302;409/downstream errors use disk.
# CORS (P825): the board's 3D viewer on proto.bar fetches these, and a browser
# checks every hop -- this one and R2's (its bucket CORS policy). Public files.
location ~ ^/(?:ftesurf/)?maps/(?<ftemap>[A-Za-z0-9_-]+)\.bsp$ {
    proxy_pass http://127.0.0.1:@PORT@;
    proxy_connect_timeout 1s;
    proxy_read_timeout 4s;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_intercept_errors on;
    error_page 409 500 502 503 504 = @r2_map_origin;
    add_header Access-Control-Allow-Origin "*" always;
}
location @r2_map_origin {
    root /srv/nvme/ftesurf-server/game/momentum;
    try_files /maps/$ftemap.bsp =404;
    limit_rate 1m;
    limit_conn ftesurf_maps 2;
    default_type application/octet-stream;
    add_header Cache-Control "public, max-age=30";
    add_header X-R2-Route "origin" always;
    add_header Access-Control-Allow-Origin "*" always;
    autoindex off;
    disable_symlinks if_not_owner;
    error_page 403 = @r2_missing;
}

location ~ ^/ftesurf/maps/zones/local/(?<ftezone>[A-Za-z0-9_-]+)\.json$ {
    proxy_pass http://127.0.0.1:@PORT@;
    proxy_connect_timeout 1s;
    proxy_read_timeout 4s;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_intercept_errors on;
    error_page 409 500 502 503 504 = @r2_zone_origin;
    add_header Access-Control-Allow-Origin "*" always;
}
location @r2_zone_origin {
    root /srv/nvme/ftesurf-site/zones;
    try_files /$ftezone.json =404;
    limit_rate 1m;
    default_type application/json;
    add_header Cache-Control "public, max-age=30";
    add_header X-R2-Route "origin" always;
    add_header Access-Control-Allow-Origin "*" always;
    autoindex off;
    disable_symlinks if_not_owner;
    error_page 403 = @r2_missing;
}

# Keep this snippet included BEFORE ftesurf-media.conf: its older ramp regexes
# remain the rollback route. These are public cosmetic assets, never recordings.
location ~ "^/ftesurf/media/rampwear/(?<fterampasset>(?:[a-z0-9_-]{1,64}\.txt|[a-z0-9_-]{1,64}\.[0-9a-f]{64}\.png(?:\.b64)?))$" {
    proxy_pass http://127.0.0.1:@PORT@;
    proxy_connect_timeout 1s;
    proxy_read_timeout 4s;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_intercept_errors on;
    error_page 409 500 502 503 504 = @r2_ramp_origin;
    add_header Access-Control-Allow-Origin "*" always;
}
location @r2_ramp_origin {
    root /srv/nvme/ftesurf-site/media/rampwear;
    try_files /$fterampasset =404;
    limit_rate 1m;
    types { image/png png; text/plain txt b64; }
    default_type application/octet-stream;
    add_header Cache-Control "public, max-age=30";
    add_header X-R2-Route "origin" always;
    add_header Access-Control-Allow-Origin "*" always;
    autoindex off;
    disable_symlinks if_not_owner;
    error_page 403 = @r2_missing;
}

location @r2_missing { return 404; }
location = /maps/ { return 404; }
location = /ftesurf/maps/ { return 404; }
location = /ftesurf/maps/zones/local/ { return 404; }
